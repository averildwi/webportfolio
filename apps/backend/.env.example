DATABASE_URL="postgresql://user:password@localhost:5432/portfolio"

# Backend menempati 3000, frontend 3001 (lihat `next dev --port 3001`).
# Kalau angka ini diubah, ikut sesuaikan FRONTEND_URL, callback OAuth di bawah,
# dan NEXT_PUBLIC_API_BASE_URL di apps/frontend/.env.local.
PORT=3000
NODE_ENV=development

# Required. Allowlist CORS sekaligus tujuan redirect OAuth.
# Boleh comma-separated untuk beberapa origin.
FRONTEND_URL="http://localhost:3001"

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="ganti-dengan-random-hex-32-byte-minimal-32-char"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="ganti-dengan-random-hex-lain-minimal-32-char"
JWT_REFRESH_EXPIRES_IN="7d"

ADMIN_EMAIL="admin@averildwi.com"
ADMIN_PASSWORD="your-admin-password"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3000/api/auth/github/callback"

RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@averildwi.com"

DISCORD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
