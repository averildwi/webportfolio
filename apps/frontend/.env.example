# Base URL of the NestJS backend, including its `/api` global prefix.
# The backend's own PORT defaults to 3000, so the frontend runs on 3001.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Public origin of this site. Used for canonical URLs and Open Graph metadata.
# Must appear in the backend's FRONTEND_URL allowlist, or CORS will reject
# every credentialed request.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
